{
  "name": "@knative-extensions/plugin-knative-event-mesh-backend",
  "version": "0.0.0-nightly",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin"
  },
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "export-dynamic": "npx janus-cli package export-dynamic-plugin --embed-as-dependencies && cp README-dynamic.md dist-dynamic/README.md"
  },
  "dependencies": {
    "@backstage/backend-common": "^0.25.0",
    "@backstage/backend-dynamic-feature-service": "^0.6.0",
    "@backstage/backend-plugin-api": "^1.2.0",
    "@backstage/backend-tasks": "^0.6.1",
    "@backstage/catalog-client": "^1.9.1",
    "@backstage/catalog-model": "^1.7.3",
    "@backstage/config": "^1.3.2",
    "@backstage/plugin-catalog-common": "^1.1.3",
    "@backstage/plugin-catalog-node": "^1.16.0",
    "@types/express": "*",
    "express": "^4.17.1",
    "express-promise-router": "^4.1.0",
    "node-fetch": "^2.6.7",
    "winston": "^3.2.1",
    "yn": "^4.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.30.0",
    "@janus-idp/cli": "^1.8.7",
    "@types/supertest": "^2.0.12",
    "msw": "^1.0.0",
    "supertest": "^6.2.4"
  },
  "files": [
    "dist"
  ]
}
